# Server Port (Render sets this automatically)
PORT=3000

# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/todo-app?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated list or * for all)
CORS_ORIGIN=*

# MongoDB Connection Pool Size (default: 50)
DB_MAX_POOL_SIZE=50

# Node Environment
NODE_ENV=production
